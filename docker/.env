# ===== Ollama 配置 =====
OLLAMA_PORT=11434
# 向量化模型
EMBEDDING_MODEL=bge-m3
# Query 改写小模型
QUERY_REWRITE_MODEL=qwen2.5:1.5b

# ===== Cross-Encoder 配置 =====
CROSSENCODER_PORT=8765
# 精排模型（多语言，与 BGE-M3 配套）
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 运行时设备：cpu / cuda
CROSSENCODER_DEVICE=cpu
# 最大序列长度
CROSSENCODER_MAX_LENGTH=512
